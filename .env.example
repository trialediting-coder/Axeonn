# .env.example
# Axeon Studio environment variables

AUTH_SECRET=
ADMIN_EMAIL=
# Signs the owner's day-30 / day-90 notes to clients (lib/clientNotes.ts). Defaults to Hayder.
OWNER_NAME=
ADMIN_PASSWORD_HASH=
CMS_API_TOKEN=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
# Optional -- defaults to insights@axeonstudio.co if unset. Resend will
# silently fail to send unless this domain is verified in the Resend
# dashboard first.
RESEND_FROM_EMAIL=
# Optional -- client-facing mail for the onboarding portal (/welcome/<token>):
# the welcome link, 6-digit codes, nudges. Defaults to hello@axeonstudio.co on
# the same verified domain.
RESEND_CLIENT_FROM_EMAIL=
RESEND_CLIENT_REPLY_TO=
# Optional -- from address for lead follow-up emails; defaults to leads@axeonstudio.co (same verified domain).
RESEND_SEQUENCE_FROM_EMAIL=
# Optional -- signs the portal's 30-day device cookie. Falls back to AUTH_SECRET.
ONBOARDING_COOKIE_SECRET=
# Optional -- salts the visitor hash for client-site tracking (/api/t). Falls
# back to AUTH_SECRET. Rotating it only resets "visitors" counts mid-month.
# It also signs the unsubscribe links in follow-up emails; rotating it breaks old links.
TRACKING_SALT=
# Also authorizes the 15-minute follow-up cron (/api/cron/sequences).
CRON_SECRET=

# --- Stripe (see docs/stripe.md) ---
# Restricted key (rk_...) with the permissions listed in docs/stripe.md. Never sk_.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) for the /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Deposit share of a project total, in percent. Default 50.
STRIPE_DEPOSIT_PERCENT=50
# Leave false until a tax registration shows "Collecting" in Stripe Tax, otherwise
# Stripe reports tax as enabled while collecting nothing.
STRIPE_AUTOMATIC_TAX=false
# Customer Portal hosted login URL (Dashboard -> Settings -> Billing -> Customer portal).
# Shown in the admin billing console so it can be sent to clients.
STRIPE_PORTAL_LOGIN_URL=

# --- Airtable (lib/airtable.ts) ---
# Personal access token with data.records:read + data.records:write on the
# "Axeon Client Onboarding" base only (airtable.com/create/tokens). The site writes
# website leads and onboarding progress straight to Airtable > Clients with it.
AIRTABLE_TOKEN=

# Vercel sends this as a Bearer token on every cron call (blog publishing, the
# daily onboarding nudges and the 1st-of-the-month client reports). Without it
# the cron routes answer 401 and never run.
# CRON_SECRET is listed above.

# Axeon's own Google review link, offered on the day-90 note's "yes" page. Optional.
GOOGLE_REVIEW_URL=

# --- Twilio (lib/twilio.ts): the AxeonCORE phone layer ---
# Master account. Buys one local number per client and signs the webhooks under /api/phone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional. The public origin Twilio calls back; defaults to https://axeonstudio.co.
# Must match the deployed host exactly or every webhook fails its signature check.
PHONE_WEBHOOK_ORIGIN=

# --- Web push (lib/push.ts): lead notifications in AxeonPROOF ---
# Generate once with: npx web-push generate-vapid-keys
# Without them every lead alert falls back to a text to the owner's cell (not 8 pm to 8 am) and an email.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Optional. Contact for the push services; default mailto:hello@axeonstudio.co
WEB_PUSH_SUBJECT=

# --- Meta (lib/meta.ts): Facebook Messenger + Instagram DMs into the inbox (AxeonCORE, AxeonGROWTH), reels (AxeonGROWTH) ---
# developers.facebook.com > the Axeon app > App settings > Basic. Every Meta route answers 503
# until META_APP_ID, META_APP_SECRET, META_VERIFY_TOKEN and SECRETS_KEY are all set.
# Owner checklist: docs/meta-go-live.md. The login redirect is $APP_URL/api/meta/callback, so APP_URL
# (https://app.axeonstudio.co) must be set wherever Meta login is used.
META_APP_ID=
# Checks webhook signatures and the deauthorize / data-deletion signed_request. Vercel only.
META_APP_SECRET=
# Any long random string; the same value goes in the app's Webhooks "Verify token" field.
META_VERIFY_TOKEN=
# 32 random bytes, base64 (openssl rand -base64 32). Seals page tokens, AES-256-GCM (lib/secretBox.ts).
# Never change it once pages are connected: every stored token would stop opening.
SECRETS_KEY=
# Optional: Facebook Login for Business configuration id (used instead of the scope list).
META_LOGIN_CONFIG_ID=
# Set to 1 only after Meta App Review approves; shows the optional "Connect Facebook" step in client portals.
META_PORTAL_LIVE=
# --- Vercel Blob (reels uploads, @vercel/blob). Vercel adds it when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Business audits (lib/dataforseo.ts, lib/audits.ts)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# DATAFORSEO_BASE=https://sandbox.api.dataforseo.com   # local only: free sample data
# AUDIT_MONTHLY_CAP_USD=25
# PAGESPEED_API_KEY=
