{
  "crons": [
    { "path": "/api/cron/generate-post", "schedule": "0 13 * * 0" },
    { "path": "/api/cron/publish-scheduled", "schedule": "0 13 * * *" },
    { "path": "/api/cron/onboarding-nudges", "schedule": "0 15 * * *" }
  ],
  "redirects": [
    { "source": "/pay", "destination": "/book", "permanent": false },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.axeonstudio.co" }],
      "destination": "https://axeonstudio.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.axeonstudio.co" }],
      "destination": "https://axeonstudio.co/:path*",
      "permanent": true
    }
  ]
}
